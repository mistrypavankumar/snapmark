{
  "name": "snapmark",
  "productName": "Snapmark",
  "version": "0.1.0",
  "description": "Local screenshot capture and annotation for macOS",
  "private": true,
  "main": "out/main/index.js",
  "author": "Pavan Kumar Mistry",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder --mac --publish never",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "konva": "^10.7.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
